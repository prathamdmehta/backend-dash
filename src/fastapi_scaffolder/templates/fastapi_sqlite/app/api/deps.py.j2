{% if auth -%}
# Shared FastAPI dependencies used across route modules.

import jwt
from fastapi import Depends
from fastapi.security import OAuth2PasswordBearer
from sqlalchemy.orm import Session

from app.core.config import settings
from app.core.exceptions import UnauthorizedException
from app.core.security import decode_access_token
from app.db.session import get_db  # noqa: F401
from app.models.user import User
from app.repositories.user_repository import UserRepository

oauth2_scheme = OAuth2PasswordBearer(tokenUrl=f"{settings.API_V1_PREFIX}/auth/login", auto_error=False)


def get_current_user(
    token: str | None = Depends(oauth2_scheme),
    db: Session = Depends(get_db),
) -> User:
    if token is None:
        raise UnauthorizedException("Not authenticated.")

    try:
        payload = decode_access_token(token)
    except jwt.PyJWTError:
        raise UnauthorizedException("Invalid or expired token.")

    user_id = payload.get("sub")
    if user_id is None:
        raise UnauthorizedException("Invalid token payload.")

    user = UserRepository(db).get(int(user_id))
    if user is None or not user.is_active:
        raise UnauthorizedException("User not found or inactive.")

    return user
{% else -%}
# Shared FastAPI dependencies used across route modules.
# Re-exported here so routes just do `from app.api.deps import get_db`
# instead of reaching into app.db.session directly. This is also the
# natural place to add get_current_user() if you introduce auth later
# (regenerate with --auth for the full JWT-based version).

from app.db.session import get_db  # noqa: F401
{% endif -%}
